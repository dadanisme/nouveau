+  private func attachmentProcessed(content: NSExtensionItem) {
+    self.processedCount += 1
+    NSLog("[DEBUG] attachmentProcessed: %d / %d", self.processedCount, content.attachments?.count ?? 0)
+    if self.processedCount == content.attachments?.count ?? 0 {
+      self.saveAndRedirect()
+    }
+  }
+
+  private func saveAndRedirect() {
+    let userDefaults = UserDefaults(suiteName: self.hostAppGroupIdentifier)
+
+    if !self.sharedMedia.isEmpty {
+      // Priority 1: Media/files — save media to primary key
       userDefaults?.set(self.toData(data: self.sharedMedia), forKey: self.sharedKey)
+      // Also save any text/URL to secondary key so host app can access both
+      if !self.sharedWebUrl.isEmpty {
+        let urlText = self.sharedWebUrl.map { $0.url }.joined(separator: "\n")
+        userDefaults?.set(urlText, forKey: "\(self.sharedKey)_text")
+      } else if !self.sharedText.isEmpty {
+        let textContent = self.sharedText.joined(separator: "\n")
+        userDefaults?.set(textContent, forKey: "\(self.sharedKey)_text")

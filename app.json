{
  "expo": {
    "name": "Nouveau",
    "slug": "nouveau",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nouveau",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.muhammadramdan.nouveau",
      "appleTeamId": "C4SQMCY5WT",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow Nouveau to save receipt photos to your library.",
        "NSPhotoLibraryAddUsageDescription": "Allow Nouveau to save receipt photos to your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.muhammadramdan.nouveau"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9EB",
          "dark": {
            "backgroundColor": "#FFF9EB"
          }
        }
      ],
      "expo-sqlite",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.985981017559-vuvvlmm8sgm29ts9lkmggiosrvbav0c2"
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 5,
            "NSExtensionActivationSupportsFileWithMaxCount": 5
          },
          "iosShareExtensionName": "Nouveau Share Extension",
          "androidIntentFilters": ["text/*", "image/*", "application/pdf"],
          "androidMainActivityAttributes": {
            "android:launchMode": "singleTask"
          },
          "disableExperimental": true
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Nouveau to save receipt photos to your library.",
          "savePhotosPermission": "Allow Nouveau to save receipt photos to your library.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c553fd91-5451-4de0-b39d-191fde70c2b8",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "NouveauShareExtension",
                  "bundleIdentifier": "com.muhammadramdan.nouveau.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.com.muhammadramdan.nouveau"]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "dadanisme"
  }
}

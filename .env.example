EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key-here
# Optional: point a dev build at another API server (e.g. a tunnel to a local moneymail).
# Defaults to https://moneymail-api-1016548251938.asia-southeast2.run.app
# EXPO_PUBLIC_API_BASE_URL=https://your-tunnel.example.com
# RevenueCat public SDK keys for Nouveau Premium (#79). Per store; with neither set, the Test
# Store key is used on both platforms (development, until store products exist). With no key at
# all, Premium shows as unavailable and the rest of the app works as usual.
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx
# EXPO_PUBLIC_REVENUECAT_TEST_STORE_KEY=test_xxx
